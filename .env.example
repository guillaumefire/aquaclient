# Local (.env) OU variables d'environnement Render (Environment)
# Sur Render le fichier .env N'EST PAS déployé — il faut les saisir dans le dashboard.

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxx

# Mot de passe Postgres (Settings → Database) — utile pour créer les tables
SUPABASE_DB_PASSWORD=

# Ou URI pooler complète (recommandé sur Render)
# DATABASE_URL=postgresql://postgres.xxxx:PASS@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Clé secrète Auth admin (Settings → API → service_role / secret)
SUPABASE_SECRET_KEY=
